# Server Configuration (Port 5002 to avoid collision with v1 on 5001)
PORT=5002
NODE_ENV=development

# MongoDB Connection String (Primary Storage Engine)
MONGO_URI=mongodb://127.0.0.1:27017/scale_10k_db
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=50

# Redis In-Memory Cache & Mutex Lock Layer
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Caching Expiration Policies (seconds)
CACHE_TTL_CATALOG=120
CACHE_TTL_PRODUCT=600
CACHE_TTL_NULL=60
CACHE_JITTER_WINDOW=30
CACHE_LOCK_TTL=5
